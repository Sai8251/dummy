// 🚀 3. MAIN EXECUTION FUNCTION
function sendB2BReportsWithInlineSummary() {
  const folder = DriveApp.getFolderById(B2B_CONFIG.FOLDER_ID);
  const errors = [];
  const TEAM_NAMES = ['EAST', 'NORTH', 'SOUTH', 'WEST', 'E2E'];


  // Load all folder files into a map for fast lookup
  const filesInFolder = folder.getFiles();
  const allFilesMap = {};
  while (filesInFolder.hasNext()) {
    const file = filesInFolder.next();
    allFilesMap[file.getName().toLowerCase()] = file;
  }
 
  const today = new Date();
  const formattedDate = Utilities.formatDate(today, Session.getScriptTimeZone(), 'MMM dd, yyyy');
  const emailSubject = `${B2B_CONFIG.SUBJECT_PREFIX} - ${formattedDate}`;


  // Loop through the distribution map
  for (const primaryFileName in B2B_FILE_RECIPIENT_MAP) {
    const recipients = B2B_FILE_RECIPIENT_MAP[primaryFileName];
    const primaryFile = allFilesMap[primaryFileName.toLowerCase()];
   
    if (!primaryFile) {
      Logger.log(`SKIPPED: File "${primaryFileName}" not found in Drive folder.`);
      errors.push(`File not found: ${primaryFileName}`);
      continue;
    }


    try {
      const namePart = primaryFileName.replace(/\.[^/.]+$/, "");
      let personalizedName;
     
      // Automatic Team vs Individual Greeting Logic
      if (TEAM_NAMES.includes(namePart.toUpperCase())) {
        personalizedName = `${namePart.toUpperCase()} Region Team`;
      } else {
        personalizedName = namePart.charAt(0).toUpperCase() + namePart.slice(1);
      }
     
      Logger.log(`Generating native HTML summary view for: ${namePart}`);
     
      // =========================================================================
      // 🌟 NATIVE GRID ENGINE: Bypasses UrlFetchApp to prevent 400 Errors completely
      // =========================================================================
      var workbook = SpreadsheetApp.open(primaryFile);
      var sheet = workbook.getSheetByName("Executive Summary") || workbook.getSheets()[0];
     
      var lastRow = sheet.getLastRow();
      var lastCol = sheet.getLastColumn();
     
      // Target the beautiful dashboard cards (From Column B to Column I)
      var startRow = 2;
      var startCol = 2;
     
      var range = sheet.getRange(startRow, startCol, (lastRow - startRow + 1), (lastCol - startCol + 1));
      var values = range.getValues();
      var backgrounds = range.getBackgrounds();
      var fontColors = range.getFontColors();
      var fontWeights = range.getFontWeights();
     
      var cleanHtmlTable = '<table style="border-collapse: collapse; font-family: \'Segoe UI\', Calibri, sans-serif; font-size: 13px; width: 100%; max-width: 750px; border: 1px solid #dcdcdc; box-shadow: 0 4px 6px rgba(0,0,0,0.05);">';
     
      for (var r = 0; r < values.length; r++) {
        cleanHtmlTable += '<tr style="height: 24px;">';
        for (var c = 0; c < values[r].length; c++) {
          var cellValue = values[r][c];
          var bg = backgrounds[r][c];
          var color = fontColors[r][c];
          var weight = fontWeights[r][c];
         
          // Format displays cleanly mapping the source data types
          var displayValue = cellValue;
          if (cellValue instanceof Date) {
            displayValue = Utilities.formatDate(cellValue, Session.getScriptTimeZone(), "dd-MMM-yyyy");
          } else if (typeof cellValue === 'number') {
            if (cellValue === 0) {
              displayValue = "0";
            } else if (cellValue > 0 && cellValue <= 2 && (bg === '#6496ff' || bg === '#64c878' || color === '#006400' || color === '#ff0000' || c === 3 || c === 6 || c === 7)) {
              // Safely preserve rates and growth indicators as percentages
              displayValue = (cellValue * 100).toFixed(1) + '%';
            } else if (cellValue > 10) {
              displayValue = cellValue.toLocaleString('en-IN');
            }
          }
         
          // Style mapping engine replicating the premium Excel layout natively
          var cellStyle = 'padding: 6px 8px; border: 1px solid #e0e0e0; text-align: center; vertical-align: middle;';
          if (bg && bg !== '#ffffff') cellStyle += ' background-color: ' + bg + ';';
          if (color && color !== '#000000') cellStyle += ' color: ' + color + ';';
          if (weight === 'bold') cellStyle += ' font-weight: bold;';
         
          if (c === 0 && r > 2) {
            cellStyle += ' text-align: left; font-weight: 500;';
          }
         
          // Render the wide top merged dashboard header card cleanly
          if (r === 0 || r === 1 || r === 2) {
            if (c === 0 && r === 0) {
              cellStyle += ' font-size: 16px; font-weight: bold; letter-spacing: 0.5px;';
              cleanHtmlTable += '<td colspan="' + values[r].length + '" style="' + cellStyle + '">' + displayValue + '</td>';
              break;
            } else if (r > 0 && c > 0 && values[r][0] === values[0][0]) {
              continue;
            }
          }
         
          cleanHtmlTable += '<td style="' + cellStyle + '">' + (displayValue === '' ? '&nbsp;' : displayValue) + '</td>';
        }
        cleanHtmlTable += '</tr>';
      }
      cleanHtmlTable += '</table>';
      // =========================================================================


      // HTML Email Template Design
      const htmlBody = `
        <p style="font-family: 'Segoe UI', Calibri, sans-serif; font-size: 14px;">Hi ${personalizedName},</p>
        <p style="font-family: 'Segoe UI', Calibri, sans-serif; font-size: 14px;">Please find attached the automated B2B PTL Daily Performance Report for Jul'26 month.</p>
        <p style="font-family: 'Segoe UI', Calibri, sans-serif; font-size: 14px;"><b>(TEST Ignore) B2B Executive Summary Dashboard:</b></p>
        <div style="background-color: #f5f6f8; padding: 15px; border-radius: 6px; display: inline-block;">
          ${cleanHtmlTable}
        </div>
        <br><br>
        <p style="font-family: 'Segoe UI', Calibri, sans-serif; font-size: 14px;">Best regards,<br><b>${B2B_CONFIG.SENDER_NAME}</b></p>
      `;


      // Dispatch Email using GmailApp
      GmailApp.sendEmail(
        recipients.join(','),
        emailSubject,
        '', // Empty plaintext body
        {
          htmlBody: htmlBody,
          attachments: [primaryFile.getBlob().setName(primaryFile.getName())],
          name: B2B_CONFIG.SENDER_NAME
        }
      );


      Logger.log(`✅ Email with Native Inline Dashboard sent successfully for "${primaryFileName}"`);
   
    } catch (error) {
      Logger.log(`❌ FAILED to process "${primaryFileName}": ${error.message}`);
      errors.push(`File: ${primaryFileName}, Error: ${error.message}`);
    }
  }


  // Admin notification for any file lookup failures
  if (errors.length > 0 && B2B_CONFIG.ADMIN_EMAIL) {
    GmailApp.sendEmail(
      B2B_CONFIG.ADMIN_EMAIL,
      'Error Report: B2B Mail Distribution Failure',
      'The following errors or missing files were encountered during execution:\n\n' + errors.join('\n')
    );
  }
}

