Private Sub ProcessSheet(ByVal wbSource As Workbook, ByVal sheetName As String, ByVal headerRow As Long, _
                         ByVal configDict As Object, ByVal baseOutputPath As String, ByVal outputSubFolder As String, _
                         ByVal masterBDList As Variant, ByVal masterKAMList As Variant)
    Dim wsSource As Worksheet, colNum As Variant, key As Variant, fso As Object
    Dim mainFolder As String, currentSavePath As String
    
    On Error Resume Next: Set wsSource = wbSource.Sheets(sheetName): On Error GoTo 0
    If wsSource Is Nothing Then Exit Sub
    
    Set fso = CreateObject("Scripting.FileSystemObject")
    
    For Each key In configDict.Keys
        Dim targetList As Variant: targetList = configDict(key)
        
        ' Process only populated target arrays
        If UBound(targetList) >= LBound(targetList) Then
            mainFolder = IIf(outputSubFolder = "", baseOutputPath, baseOutputPath & outputSubFolder & "\")
            currentSavePath = mainFolder & SanitizeFileName(Trim(CStr(key))) & "\"
            
            If Not fso.FolderExists(mainFolder) Then CreateFolderRecursive fso, mainFolder
            If Not fso.FolderExists(currentSavePath) Then fso.CreateFolder currentSavePath
            
            colNum = Application.Match(CStr(key), wsSource.Rows(headerRow), 0)
            
            If Not IsError(colNum) Then
                Dim item As Variant: For Each item In targetList
                    SaveFilteredDataSheetws wbSource, sheetName, currentSavePath, CStr(item), headerRow, CLng(colNum), CStr(key), masterBDList, masterKAMList
                Next item
            End If
        End If
    Next key
End Sub

Private Sub SaveFilteredDataSheetws(ByVal wbSource As Workbook, ByVal sheetName As String, ByVal savePath As String, ByVal fName As String, ByVal hRow As Long, ByVal colIdx As Long, ByVal splitKey As String, ByVal masterBDList As Variant, ByVal masterKAMList As Variant)
    Dim wbNew As Workbook, wsNewPTL As Worksheet
    Dim lastRow As Long, r As Long, matchFound As Boolean, checkVal As Variant
    Dim realLastRow As Long, realLastCol As Long, dataRange As Range
    
    wbSource.Sheets(sheetName).Copy
    Set wbNew = ActiveWorkbook
    Set wsNewPTL = wbNew.Sheets(1)
    wsNewPTL.Name = "PTL"
    
    realLastRow = wsNewPTL.Cells.Find("*", SearchOrder:=xlByRows, SearchDirection:=xlPrevious).Row
    For r = realLastRow To 1 Step -1
        If UCase(Trim(CStr(wsNewPTL.Cells(r, 1).Value))) = "TOTAL" Then wsNewPTL.Rows(r).Delete
    Next r
    
    lastRow = wsNewPTL.Cells.Find("*", SearchOrder:=xlByRows, SearchDirection:=xlPrevious).Row
    matchFound = False
    
    For r = lastRow To (hRow + 1) Step -1
        checkVal = wsNewPTL.Cells(r, colIdx).Value
        If UCase(Trim(CStr(checkVal))) <> UCase(Trim(fName)) Then
            wsNewPTL.Rows(r).Delete
        Else
            matchFound = True
        End If
    Next r
    
    If matchFound Then
        Application.Calculate
        
        realLastRow = wsNewPTL.Cells.Find("*", SearchOrder:=xlByRows, SearchDirection:=xlPrevious).Row
        realLastCol = wsNewPTL.Cells.Find("*", SearchOrder:=xlByColumns, SearchDirection:=xlPrevious).Column
        Set dataRange = wsNewPTL.Range(wsNewPTL.Cells(1, 1), wsNewPTL.Cells(realLastRow, realLastCol))
        dataRange.Copy
        dataRange.PasteSpecial Paste:=xlPasteValues
        Application.CutCopyMode = False
        
        AddSubtotalRow wsNewPTL, hRow
        wsNewPTL.Cells.EntireColumn.AutoFit
        On Error Resume Next: wsNewPTL.Columns("I:N").Hidden = True: On Error GoTo 0
        
        ' GENERATE CREATIVE DASHBOARD
        CreateStunningSummary wbNew, splitKey, fName, masterBDList, masterKAMList
        
        Dim finalFileName As String
        finalFileName = savePath & SanitizeFileName(Trim(fName)) & ".xlsx"
        wbNew.SaveAs fileName:=finalFileName, FileFormat:=51
        wbNew.Close False
    Else
        wbNew.Close False
    End If
End Sub

Private Sub CreateStunningSummary(wb As Workbook, splitKey As String, fName As String, masterBDList As Variant, masterKAMList As Variant)
    Dim wsData As Worksheet, wsSum As Worksheet
    Set wsData = wb.Sheets("PTL")
    Set wsSum = wb.Sheets.Add(Before:=wb.Sheets(1))
    wsSum.Name = "Executive Summary"
    wsSum.Tab.Color = RGB(31, 78, 120)
    wsSum.Application.ActiveWindow.DisplayGridlines = False
    
    wsSum.Cells.Interior.Color = RGB(245, 246, 248)
    
    Dim dictBD As Object, dictKAM As Object
    Set dictBD = CreateObject("Scripting.Dictionary"): Set dictKAM = CreateObject("Scripting.Dictionary")
    dictBD.CompareMode = TextCompare: dictKAM.CompareMode = TextCompare
    
    Dim lastRow As Long, i As Long
    lastRow = wsData.Cells.Find("*", SearchOrder:=xlByRows, SearchDirection:=xlPrevious).Row
    
    Dim bdName As String, kamName As String
    Dim tTgt As Double, tAct As Double, rTgt As Double, rAct As Double
    Dim ov_tTgt As Double, ov_tAct As Double, ov_rTgt As Double, ov_rAct As Double
    Dim ov_momRev As Double, ov_momTon As Double, ov_yoyRev As Double, ov_yoyTon As Double
    Dim w0T As Double, w1T As Double, w2T As Double, w3T As Double, w4T As Double
    Dim w0R As Double, w1R As Double, w2R As Double, w3R As Double
    
    ' Extract Data with Safe Numeric Evaluation (Prevents Target mismatch bugs)
    For i = 8 To lastRow
        If UCase(Trim(wsData.Cells(i, 1).Value)) <> "TOTAL" And _
           (Trim(wsData.Cells(i, 1).Value) <> "" Or Trim(wsData.Cells(i, 2).Value) <> "") Then
            
            bdName = Trim(CStr(wsData.Cells(i, 4).Value))
            kamName = Trim(CStr(wsData.Cells(i, 5).Value))
            
            tTgt = GetSafeDouble(wsData.Cells(i, 48).Value)
            tAct = GetSafeDouble(wsData.Cells(i, 49).Value)
            rTgt = GetSafeDouble(wsData.Cells(i, 51).Value)
            rAct = GetSafeDouble(wsData.Cells(i, 52).Value)
            
            ov_tTgt = ov_tTgt + tTgt: ov_tAct = ov_tAct + tAct: ov_rTgt = ov_rTgt + rTgt: ov_rAct = ov_rAct + rAct
            ov_yoyRev = ov_yoyRev + GetSafeDouble(wsData.Cells(i, 59).Value)
            ov_yoyTon = ov_yoyTon + GetSafeDouble(wsData.Cells(i, 60).Value)
            ov_momRev = ov_momRev + GetSafeDouble(wsData.Cells(i, 63).Value)
            ov_momTon = ov_momTon + GetSafeDouble(wsData.Cells(i, 64).Value)
            
            w0T = w0T + GetSafeDouble(wsData.Cells(i, 66).Value)
            w1T = w1T + GetSafeDouble(wsData.Cells(i, 67).Value)
            w2T = w2T + GetSafeDouble(wsData.Cells(i, 68).Value)
            w3T = w3T + GetSafeDouble(wsData.Cells(i, 69).Value)
            w4T = w4T + GetSafeDouble(wsData.Cells(i, 70).Value)
            
            w0R = w0R + GetSafeDouble(wsData.Cells(i, 71).Value)
            w1R = w1R + GetSafeDouble(wsData.Cells(i, 72).Value)
            w2R = w2R + GetSafeDouble(wsData.Cells(i, 73).Value)
            w3R = w3R + GetSafeDouble(wsData.Cells(i, 74).Value)
            
            ' STRICT CLASSIFICATION BASED ON MASTER ARRAYS
            If bdName <> "" And IsInArray(bdName, masterBDList) Then
                If Not dictBD.Exists(bdName) Then dictBD.Add bdName, Array(tTgt, tAct, rTgt, rAct) Else _
                    Dim tmpBD As Variant: tmpBD = dictBD(bdName): tmpBD(0) = tmpBD(0) + tTgt: tmpBD(1) = tmpBD(1) + tAct: tmpBD(2) = tmpBD(2) + rTgt: tmpBD(3) = tmpBD(3) + rAct: dictBD(bdName) = tmpBD
            End If
            
            If kamName <> "" And IsInArray(kamName, masterKAMList) Then
                If Not dictKAM.Exists(kamName) Then dictKAM.Add kamName, Array(tTgt, tAct, rTgt, rAct) Else _
                    Dim tmpKAM As Variant: tmpKAM = dictKAM(kamName): tmpKAM(0) = tmpKAM(0) + tTgt: tmpKAM(1) = tmpKAM(1) + tAct: tmpKAM(2) = tmpKAM(2) + rTgt: tmpKAM(3) = tmpKAM(3) + rAct: dictKAM(kamName) = tmpKAM
            End If
        End If
    Next i
    
    Dim dashTitle As String
    If splitKey = "Region" Then dashTitle = UCase(Trim(fName)) & " REGION - B2B PTL EXECUTIVE DASHBOARD" _
    Else If splitKey = "BD" Then dashTitle = UCase(Trim(fName)) & " (BD) - PERFORMANCE DASHBOARD" _
    Else If splitKey = "Current BD/KAM" Then dashTitle = UCase(Trim(fName)) & " (KAM) - PERFORMANCE DASHBOARD" _
    Else dashTitle = UCase(Trim(fName)) & " - B2B PTL SUMMARY"
    
    With wsSum.Range("B2:I4")
        .Merge: .Value = dashTitle
        .Font.Name = "Segoe UI Black": .Font.Size = 22: .Font.Color = RGB(255, 255, 255)
        .Interior.Color = RGB(20, 36, 89): .HorizontalAlignment = xlCenter: .VerticalAlignment = xlCenter
    End With
    
    Dim rIdx As Long: rIdx = 6
    
    ' ================= 1. OVERALL SECTION =================
    wsSum.Range("B" & rIdx & ":F" & rIdx).Merge: wsSum.Range("B" & rIdx).Value = "OVERALL PERFORMANCE"
    FormatHeader wsSum.Range("B" & rIdx & ":F" & rIdx), RGB(68, 84, 106)
    rIdx = rIdx + 1: wsSum.Cells(rIdx, 2).Value = "Metric": wsSum.Cells(rIdx, 3).Value = "Target": wsSum.Cells(rIdx, 4).Value = "Actual": wsSum.Range("E" & rIdx & ":F" & rIdx).Merge: wsSum.Cells(rIdx, 5).Value = "Achieved %"
    FormatHeader wsSum.Range("B" & rIdx & ":F" & rIdx), RGB(90, 105, 125)
    
    rIdx = rIdx + 1: wsSum.Cells(rIdx, 2).Value = "Tonnage (Tons)": wsSum.Cells(rIdx, 3).Value = ov_tTgt: wsSum.Cells(rIdx, 4).Value = ov_tAct
    wsSum.Range("E" & rIdx & ":F" & rIdx).Merge: If ov_tTgt <> 0 Then wsSum.Cells(rIdx, 5).Value = ov_tAct / ov_tTgt Else wsSum.Cells(rIdx, 5).Value = 0
    ApplyDataFormat wsSum.Range("B" & rIdx & ":F" & rIdx), True, "#,##0.0", "0.0%"
    AddDataBar wsSum.Range("E" & rIdx), RGB(100, 150, 255)
    
    rIdx = rIdx + 1: wsSum.Cells(rIdx, 2).Value = "Revenue (" & ChrW(8377) & ")": wsSum.Cells(rIdx, 3).Value = ov_rTgt: wsSum.Cells(rIdx, 4).Value = ov_rAct
    wsSum.Range("E" & rIdx & ":F" & rIdx).Merge: If ov_rTgt <> 0 Then wsSum.Cells(rIdx, 5).Value = ov_rAct / ov_rTgt Else wsSum.Cells(rIdx, 5).Value = 0
    ApplyDataFormat wsSum.Range("B" & rIdx & ":F" & rIdx), False, ChrW(8377) & " #,##0", "0.0%"
    AddDataBar wsSum.Range("E" & rIdx), RGB(100, 200, 120)
    
    ' ================= 2. MoM & YoY WITH ARROWS =================
    rIdx = rIdx + 3: wsSum.Range("B" & rIdx & ":I" & rIdx).Merge: wsSum.Range("B" & rIdx).Value = "MONTH-ON-MONTH (MoM) & YOY COMPARISON"
    FormatHeader wsSum.Range("B" & rIdx & ":I" & rIdx), RGB(68, 84, 106)
    rIdx = rIdx + 1: wsSum.Cells(rIdx, 2).Value = "Metric": wsSum.Cells(rIdx, 3).Value = "MTD Actual": wsSum.Cells(rIdx, 4).Value = "Jun '26": wsSum.Cells(rIdx, 5).Value = "MoM Growth"
    wsSum.Range("F" & rIdx & ":G" & rIdx).Merge: wsSum.Cells(rIdx, 6).Value = "Jul '25": wsSum.Range("H" & rIdx & ":I" & rIdx).Merge: wsSum.Cells(rIdx, 8).Value = "YoY Growth"
    FormatHeader wsSum.Range("B" & rIdx & ":I" & rIdx), RGB(90, 105, 125)
    
    rIdx = rIdx + 1: wsSum.Cells(rIdx, 2).Value = "Tonnage": wsSum.Cells(rIdx, 3).Value = ov_tAct: wsSum.Cells(rIdx, 4).Value = ov_momTon
    If ov_momTon <> 0 Then wsSum.Cells(rIdx, 5).Value = (ov_tAct - ov_momTon) / ov_momTon Else wsSum.Cells(rIdx, 5).Value = 0
    wsSum.Range("F" & rIdx & ":G" & rIdx).Merge: wsSum.Cells(rIdx, 6).Value = ov_yoyTon
    wsSum.Range("H" & rIdx & ":I" & rIdx).Merge: If ov_yoyTon <> 0 Then wsSum.Cells(rIdx, 8).Value = (ov_tAct - ov_yoyTon) / ov_yoyTon Else wsSum.Cells(rIdx, 8).Value = 0
    ApplyDataFormat wsSum.Range("B" & rIdx & ":I" & rIdx), True, "#,##0.0", "[Color10]? 0.0%;[Red]? 0.0%;""-"""
    
    rIdx = rIdx + 1: wsSum.Cells(rIdx, 2).Value = "Revenue": wsSum.Cells(rIdx, 3).Value = ov_rAct: wsSum.Cells(rIdx, 4).Value = ov_momRev
    If ov_momRev <> 0 Then wsSum.Cells(rIdx, 5).Value = (ov_rAct - ov_momRev) / ov_momRev Else wsSum.Cells(rIdx, 5).Value = 0
    wsSum.Range("F" & rIdx & ":G" & rIdx).Merge: wsSum.Cells(rIdx, 6).Value = ov_yoyRev
    wsSum.Range("H" & rIdx & ":I" & rIdx).Merge: If ov_yoyRev <> 0 Then wsSum.Cells(rIdx, 8).Value = (ov_rAct - ov_yoyRev) / ov_yoyRev Else wsSum.Cells(rIdx, 8).Value = 0
    ApplyDataFormat wsSum.Range("B" & rIdx & ":I" & rIdx), False, ChrW(8377) & " #,##0", "[Color10]? 0.0%;[Red]? 0.0%;""-"""
    
    ' ================= 3. WEEKLY TREND WITH SPARKLINES =================
    rIdx = rIdx + 3: wsSum.Range("B" & rIdx & ":I" & rIdx).Merge: wsSum.Range("B" & rIdx).Value = "WEEKLY PERFORMANCE TREND"
    FormatHeader wsSum.Range("B" & rIdx & ":I" & rIdx), RGB(68, 84, 106)
    
    rIdx = rIdx + 1: wsSum.Cells(rIdx, 2).Value = "Metric": wsSum.Cells(rIdx, 3).Value = "Wk 0": wsSum.Cells(rIdx, 4).Value = "Wk 1": wsSum.Cells(rIdx, 5).Value = "Wk 2": wsSum.Cells(rIdx, 6).Value = "Wk 3"
    wsSum.Cells(rIdx, 7).Value = "Wk 4": wsSum.Range("H" & rIdx & ":I" & rIdx).Merge: wsSum.Cells(rIdx, 8).Value = "Trend (Mini-Chart)"
    FormatHeader wsSum.Range("B" & rIdx & ":I" & rIdx), RGB(90, 105, 125)
    
    rIdx = rIdx + 1: wsSum.Cells(rIdx, 2).Value = "Tonnage": wsSum.Cells(rIdx, 3).Value = w0T: wsSum.Cells(rIdx, 4).Value = w1T: wsSum.Cells(rIdx, 5).Value = w2T: wsSum.Cells(rIdx, 6).Value = w3T: wsSum.Cells(rIdx, 7).Value = w4T
    wsSum.Range("H" & rIdx & ":I" & rIdx).Merge: wsSum.Range("H" & rIdx).SparklineGroups.Add Type:=xlSparkColumn, SourceData:=wsSum.Range("C" & rIdx & ":G" & rIdx).Address
    wsSum.Range("H" & rIdx).SparklineGroups.item(1).SeriesColor.Color = RGB(100, 150, 255)
    ApplyDataFormat wsSum.Range("B" & rIdx & ":I" & rIdx), True, "#,##0.0", "#,##0.0"
    wsSum.Range("C" & rIdx & ":G" & rIdx).NumberFormat = "#,##0.0"
    
    rIdx = rIdx + 1: wsSum.Cells(rIdx, 2).Value = "Revenue": wsSum.Cells(rIdx, 3).Value = w0R: wsSum.Cells(rIdx, 4).Value = w1R: wsSum.Cells(rIdx, 5).Value = w2R: wsSum.Cells(rIdx, 6).Value = w3R: wsSum.Cells(rIdx, 7).Value = 0
    wsSum.Range("H" & rIdx & ":I" & rIdx).Merge: wsSum.Range("H" & rIdx).SparklineGroups.Add Type:=xlSparkLine, SourceData:=wsSum.Range("C" & rIdx & ":G" & rIdx).Address
    wsSum.Range("H" & rIdx).SparklineGroups.item(1).SeriesColor.Color = RGB(100, 200, 120)
    ApplyDataFormat wsSum.Range("B" & rIdx & ":I" & rIdx), False, ChrW(8377) & " #,##0", ChrW(8377) & " #,##0"
    wsSum.Range("C" & rIdx & ":G" & rIdx).NumberFormat = ChrW(8377) & " #,##0"

    ' ================= 4. DYNAMIC TABLES WITH DATABARS =================
    If splitKey = "BD" Then
        If dictBD.Count > 0 Then rIdx = rIdx + 3: rIdx = PrintGroupTable(wsSum, rIdx, "BUSINESS DEVELOPER PERFORMANCE", dictBD)
    ElseIf splitKey = "Current BD/KAM" Then
        If dictKAM.Count > 0 Then rIdx = rIdx + 3: rIdx = PrintGroupTable(wsSum, rIdx, "KEY ACCOUNT MANAGER PERFORMANCE", dictKAM)
    Else
        If dictBD.Count > 0 Then rIdx = rIdx + 3: rIdx = PrintGroupTable(wsSum, rIdx, "BUSINESS DEVELOPMENT PERFORMANCE", dictBD)
        If dictKAM.Count > 0 Then rIdx = rIdx + 3: rIdx = PrintGroupTable(wsSum, rIdx, "KEY ACCOUNT MANAGER PERFORMANCE", dictKAM)
    End If
    
    ' Dimensions and Polishing
    wsSum.Columns("A").ColumnWidth = 3: wsSum.Columns("B").ColumnWidth = 22
    wsSum.Columns("C").ColumnWidth = 14: wsSum.Columns("D").ColumnWidth = 14: wsSum.Columns("E").ColumnWidth = 14
    wsSum.Columns("F").ColumnWidth = 14: wsSum.Columns("G").ColumnWidth = 14: wsSum.Columns("H").ColumnWidth = 8
    wsSum.Columns("I").ColumnWidth = 8: wsSum.Rows("2:4").RowHeight = 25
End Sub

' ?? SAFE NUMERIC CONVERSION HELPER
Private Function GetSafeDouble(ByVal cellVal As Variant) As Double
    If IsError(cellVal) Or IsEmpty(cellVal) Then
        GetSafeDouble = 0
    ElseIf IsNumeric(cellVal) Then
        GetSafeDouble = CDbl(cellVal)
    Else
        GetSafeDouble = 0
    End If
End Function

' ?? HELPER FUNCTION TO MATCH NAMES IN MASTER ARRAYS
Private Function IsInArray(ByVal val As String, ByVal arr As Variant) As Boolean
    Dim item As Variant
    For Each item In arr
        If UCase(Trim(CStr(item))) = UCase(Trim(val)) Then
            IsInArray = True
            Exit Function
        End If
    Next item
    IsInArray = False
End Function

Private Function PrintGroupTable(ws As Worksheet, startRow As Long, title As String, dictData As Object) As Long
    ws.Range("B" & startRow & ":I" & startRow).Merge: ws.Range("B" & startRow).Value = title: FormatHeader ws.Range("B" & startRow & ":I" & startRow), RGB(68, 84, 106)
    startRow = startRow + 1: ws.Cells(startRow, 2).Value = "Name": ws.Cells(startRow, 3).Value = "Ton Target": ws.Cells(startRow, 4).Value = "Ton Actual": ws.Cells(startRow, 5).Value = "Ton %"
    ws.Range("F" & startRow & ":G" & startRow).Merge: ws.Cells(startRow, 6).Value = "Rev Target": ws.Cells(startRow, 8).Value = "Rev Actual": ws.Cells(startRow, 9).Value = "Rev %"
    FormatHeader ws.Cells(startRow, 2), RGB(90, 105, 125): FormatHeader ws.Range("C" & startRow & ":E" & startRow), RGB(0, 112, 192): FormatHeader ws.Range("F" & startRow & ":I" & startRow), RGB(0, 176, 80)
    
    Dim rIdx As Long: rIdx = startRow + 1
    Dim key As Variant, tmp As Variant, isZebra As Boolean: isZebra = False
    
    For Each key In dictData.Keys
        tmp = dictData(key): ws.Cells(rIdx, 2).Value = key: ws.Cells(rIdx, 3).Value = tmp(0): ws.Cells(rIdx, 4).Value = tmp(1)
        If tmp(0) <> 0 Then ws.Cells(rIdx, 5).Value = tmp(1) / tmp(0) Else ws.Cells(rIdx, 5).Value = 0
        ws.Range("F" & rIdx & ":G" & rIdx).Merge: ws.Cells(rIdx, 6).Value = tmp(2): ws.Cells(rIdx, 8).Value = tmp(3)
        If tmp(2) <> 0 Then ws.Cells(rIdx, 9).Value = tmp(3) / tmp(2) Else ws.Cells(rIdx, 9).Value = 0
        
        ApplyDataFormat ws.Range("B" & rIdx & ":I" & rIdx), isZebra, "#,##0.0", "0.0%"
        ws.Range("F" & rIdx & ":H" & rIdx).NumberFormat = ChrW(8377) & " #,##0"
        
        AddDataBar ws.Range("E" & rIdx), RGB(100, 150, 255)
        AddDataBar ws.Range("I" & rIdx), RGB(100, 200, 120)
        
        isZebra = Not isZebra: rIdx = rIdx + 1
    Next key
    PrintGroupTable = rIdx
End Function

Private Sub AddDataBar(rng As Range, colorRGB As Long)
    Dim db As Databar: Set db = rng.FormatConditions.AddDataBar
    db.MinPoint.Modify newtype:=xlConditionValueNumber, newvalue:=0
    db.MaxPoint.Modify newtype:=xlConditionValueNumber, newvalue:=1
    db.BarColor.Color = colorRGB: db.BarFillType = xlDataBarFillSolid: db.Direction = xlContext
End Sub

Private Sub FormatHeader(rng As Range, bgColor As Long)
    rng.Font.Name = "Segoe UI": rng.Font.Size = 11: rng.Font.Bold = True: rng.Font.Color = RGB(255, 255, 255)
    rng.Interior.Color = bgColor: rng.HorizontalAlignment = xlCenter: rng.VerticalAlignment = xlCenter
    rng.Borders.LineStyle = xlContinuous: rng.Borders.Color = RGB(255, 255, 255)
End Sub

Private Sub ApplyDataFormat(rng As Range, isZebra As Boolean, numFormat As String, pctFormat As String)
    rng.Font.Name = "Segoe UI": rng.Font.Size = 11: rng.VerticalAlignment = xlCenter: rng.HorizontalAlignment = xlCenter
    rng.Borders.LineStyle = xlContinuous: rng.Borders.Color = RGB(220, 220, 220)
    rng.Interior.Color = RGB(255, 255, 255)
    rng.Cells(1, 1).Font.Bold = True: rng.Cells(1, 1).HorizontalAlignment = xlLeft
    
    If rng.Columns.Count = 5 Then
        rng.Cells(1, 2).NumberFormat = numFormat: rng.Cells(1, 3).NumberFormat = numFormat
        If InStr(pctFormat, "Color") > 0 Then rng.Cells(1, 4).NumberFormat = pctFormat Else rng.Cells(1, 4).NumberFormat = pctFormat
    ElseIf rng.Columns.Count = 8 Then
        rng.Cells(1, 2).NumberFormat = numFormat: rng.Cells(1, 3).NumberFormat = numFormat: rng.Cells(1, 4).NumberFormat = pctFormat
        If InStr(pctFormat, "Color") > 0 Then rng.Cells(1, 7).NumberFormat = pctFormat Else rng.Cells(1, 8).NumberFormat = pctFormat
    End If
End Sub

Private Sub AddSubtotalRow(ByVal ws As Worksheet, ByVal headerRow As Long)
    Dim lastRow As Long, lastCol As Long, C As Long
    lastRow = ws.Cells.Find("*", SearchOrder:=xlByRows, SearchDirection:=xlPrevious).Row
    lastCol = ws.Cells(headerRow, ws.Columns.Count).End(xlToLeft).Column
    ws.Cells(lastRow + 1, 1).Value = "Total"
    For C = 1 To lastCol
        If IsNumeric(ws.Cells(headerRow + 1, C).Value) And ws.Cells(headerRow + 1, C).Value <> "" Then ws.Cells(lastRow + 1, C).Formula = "=ROUNDUP(SUBTOTAL(9," & ws.Range(ws.Cells(headerRow + 1, C), ws.Cells(lastRow, C)).Address & "), 0)"
    Next C
    ws.Range(ws.Cells(lastRow + 1, 1), ws.Cells(lastRow + 1, lastCol)).Font.Bold = True: ws.Range(ws.Cells(lastRow + 1, 1), ws.Cells(lastRow + 1, lastCol)).Font.Color = vbRed
End Sub

Private Function SanitizeFileName(ByVal fileName As String) As String
    Dim invalidChars As Variant, i As Long: invalidChars = Array("/", "\", ":", "*", "?", """", "<", ">", "|"): SanitizeFileName = fileName
    For i = LBound(invalidChars) To UBound(invalidChars): SanitizeFileName = Replace(SanitizeFileName, invalidChars(i), "-"): Next i
End Function

Private Sub CreateFolderRecursive(fso As Object, ByVal path As String)
    Dim parts As Variant, currentPath As String, i As Long
    If Right(path, 1) = "\" Then path = Left(path, Len(path) - 1)
    parts = Split(path, "\"): currentPath = parts(0)
    For i = 1 To UBound(parts): currentPath = currentPath & "\" & parts(i): If Not fso.FolderExists(currentPath) Then fso.CreateFolder currentPath
    Next i
End Sub

